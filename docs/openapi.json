  "components": {
    "schemas": {
      "DeleteResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "title": "DeleteResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntelliJWorkspaceRequest": {
        "properties": {
          "namespace": {
            "type": "string",
            "title": "Namespace",
            "description": "OpenShift namespace",
            "default": "admin-devspaces"
          },
          "git_repo": {
            "type": "string",
            "title": "Git Repo",
            "description": "Git repository URL",
            "default": "https://github.com/spring-projects/spring-petclinic"
          },
          "memory_limit": {
            "type": "string",
            "title": "Memory Limit",
            "description": "Memory limit",
            "default": "8Gi"
          },
          "cpu_limit": {
            "type": "string",
            "title": "Cpu Limit",
            "description": "CPU limit",
            "default": "2000m"
          }
        },
        "type": "object",
        "title": "IntelliJWorkspaceRequest"
      },
      "VSCodeWorkspaceRequest": {
        "properties": {
          "namespace": {
            "type": "string",
            "title": "Namespace",
            "description": "OpenShift namespace",
            "default": "admin-devspaces"
          },
          "git_repo": {
            "type": "string",
            "title": "Git Repo",
            "description": "Git repository URL",
            "default": "https://github.com/quarkusio/quarkus-quickstarts"
          },
          "memory_limit": {
            "type": "string",
            "title": "Memory Limit",
            "description": "Memory limit",
            "default": "4Gi"
          },
          "cpu_limit": {
            "type": "string",
            "title": "Cpu Limit",
            "description": "CPU limit",
            "default": "2000m"
          }
        },
        "type": "object",
        "title": "VSCodeWorkspaceRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceListResponse": {
        "properties": {
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceResponse"
            },
            "type": "array",
            "title": "Workspaces"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "workspaces",
          "total"
        ],
        "title": "WorkspaceListResponse"
      },
      "WorkspaceResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "namespace": {
            "type": "string",
            "title": "Namespace"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "namespace",
          "phase"
        ],
        "title": "WorkspaceResponse"
      }
