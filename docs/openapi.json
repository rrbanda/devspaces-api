      "post": {
        "summary": "Create Vscode Workspace",
        "description": "Create a VS Code DevWorkspace",
        "operationId": "create_vscode_workspace_workspaces_vscode_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
